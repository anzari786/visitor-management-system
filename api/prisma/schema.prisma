generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ── Enums ─────────────────────────────────────

enum VisitStatus {
  active
  completed
  cancelled
}

enum VisitRequestStatus {
  pending
  approved
  rejected
}

enum VisitPurpose {
  meeting
  interview
  delivery
  official_visit
  maintenance
  other
}

enum IdType {
  national_id
  kebele_id
  passport
  drivers_license
  other
}

// ── Role ──────────────────────────────────────

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique // e.g. "admin", "front_desk"

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

// ── UserRole ──────────────────────────────────

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ── User ──────────────────────────────────────

model User {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  username     String  @unique
  passwordHash String // bcrypt, min cost 12
  phone        String?

  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true) // true on admin-created or reset accounts
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  userRoles              UserRole[]
  checkedInVisits        Visit[]        @relation("CheckedInBy")
  checkedOutVisits       Visit[]        @relation("CheckedOutBy")
  reviewedVisitRequests  VisitRequest[] @relation("ReviewedBy")

  @@map("users")
}

// ── Visitor ───────────────────────────────────

model Visitor {
  id       Int     @id @default(autoincrement())
  fullName String
  phone    String?
  idType   IdType
  idNumber String // passport or national ID number

  createdAt DateTime @default(now())

  // Relations
  visits              Visit[]
  visitRequestVisitors VisitRequestVisitor[]

  @@unique([idType, idNumber])
  @@map("visitors")
}

// ── Visit ─────────────────────────────────────

model Visit {
  id          Int @id @default(autoincrement())
  badgeNumber Int

  // Visitor
  visitorId Int
  visitor   Visitor @relation(fields: [visitorId], references: [id])

  // Department 
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  // Visit details
  hostName String

  // Status
  status VisitStatus @default(active)

  // Check-in
  checkedInAt   DateTime @default(now())
  checkedInById Int
  checkedInBy   User     @relation("CheckedInBy", fields: [checkedInById], references: [id])

  // Check-out (nullable — null means visitor is still inside)
  checkedOutAt   DateTime?
  checkedOutById Int?
  checkedOutBy   User?     @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  checkoutNote   String?

  @@index([badgeNumber]) // fast badge lookup at checkout
  @@index([visitorId]) // fast visitor history lookup
  @@index([status]) // fast "who is inside" query
  @@index([checkedInAt]) // fast date-range report queries
  @@index([departmentId]) // fast department analytics
  @@map("visits")
}

// ── Department ────────────────────────────────
model Department {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  shortName String? @unique
  color     String  @unique

  isActive Boolean @default(true) // Department operational status

  createdAt DateTime @default(now())

  // Relations
  visits        Visit[]
  visitRequests VisitRequest[]

  @@map("departments")
}

// ── VisitRequest ──────────────────────────────

model VisitRequest {
  id Int @id @default(autoincrement())

  // Host (free-text until a host directory exists)
  hostName  String
  hostEmail String?

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  purpose VisitPurpose

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  status          VisitRequestStatus @default(pending)
  rejectionReason String?            @db.Text

  reviewedAt   DateTime?
  reviewedById Int?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitors VisitRequestVisitor[]

  @@index([status])
  @@index([departmentId])
  @@index([startDate])
  @@index([createdAt])
  @@map("visit_requests")
}

model VisitRequestVisitor {
  id Int @id @default(autoincrement())

  visitRequestId Int
  visitRequest   VisitRequest @relation(fields: [visitRequestId], references: [id], onDelete: Cascade)

  visitorId Int
  visitor   Visitor @relation(fields: [visitorId], references: [id])

  // Request-specific fields not stored on Visitor
  email        String
  organization String?

  @@unique([visitRequestId, visitorId])
  @@index([visitorId])
  @@map("visit_request_visitors")
}

// ── Setting ───────────────────────────────────

model Setting {
  id Int @id @default(1) // singleton row

  // General
  orgName     String @default("Ethiopian Agricultural Transformation Institute")
  badgePrefix String @default("VMS")

  // Visitor rules
  overstayEnabled   Boolean @default(true)
  overstayAfterMins Int     @default(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Session {
  session_id String  @id
  expires    Int
  data       String?

  @@map("sessions")
  @@ignore
}
