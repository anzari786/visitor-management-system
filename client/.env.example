# Copy this file to .env.local and fill in the values for your machine.
# .env.local is gitignored — never commit real secrets or the dev-bypass flags.

# Base URL of the backend API.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# --- Development-only auth bypass ---------------------------------------
# Lets you skip the login flow locally. Both flags only take effect when
# NODE_ENV=development, so they're inert in staging/production builds
# even if accidentally left set.
#
# Server-only: read in lib/auth-server.ts before the vms.sid cookie check.
# No NEXT_PUBLIC_ prefix — never bundled into client JS.
DEV_BYPASS_AUTH=false
#
# Client-only: read in the Zustand auth store so the UI (sidebar, etc.)
# shows the same mock user the server already let through.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false