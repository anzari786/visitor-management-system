// ============================================================================
// ATI Visitor Management System (VMS) Database Schema
// ----------------------------------------------------------------------------
// This Prisma schema defines the database structure for the Visitor
// Management System.
//
// Main Features:
// • Visitor Request and Host Invitation workflows
// • Single visitor and Group visitor support
// • Single-day and Multi-day visits
// • QR Code and Visit Code based check-in/check-out
// • Reusable Badge Inventory Management
// • SSO (Single Sign-On) authentication
// • Employees and Departments synchronized from the organization's HR/Directory
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

/// How a visit was initiated.
enum VisitOrigin {
  VISITOR_REQUEST
  HOST_INVITATION
}

/// Number of visitors in a visit.
enum VisitorGroupType {
  SINGLE
  GROUP
}

/// Duration of the visit.
enum VisitDurationType {
  SINGLE_DAY
  MULTI_DAY
}

/// Overall status of a visit.
enum VisitStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RESCHEDULED
  COMPLETED
  EXPIRED
  CANCELLED
}

/// Attendance status for a visitor on a scheduled day.
enum AttendanceStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

/// Accepted visitor identification types.
enum IdentificationType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  KEBELE_ID
  OTHER
}

/// Current availability of a badge.
enum BadgeStatus {
  AVAILABLE
  ASSIGNED
  LOST
  DAMAGED
  RETIRED
}

/// Delivery channel for notifications.
enum NotificationChannel {
  EMAIL
  DASHBOARD
}

/// Notification event type.
enum NotificationType {
  VISIT_SUBMITTED
  VISIT_APPROVED
  VISIT_REJECTED
  VISIT_RESCHEDULED
  VISITOR_ARRIVED
  CHECK_OUT_COMPLETED
  OVERDUE_CHECKOUT
}

/// Dashboard user authenticated through SSO.
model User {
  id              Int      @id @default(autoincrement())
  externalSubject String   @unique @map("external_subject") // SSO subject ID
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // A User whose roles include HOST is linked to their directory record.
  employeeId Int?      @unique @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id])

  roleAssignments        UserRoleAssignment[] @relation("UserRoleAssignments")
  roleAssignmentsGranted UserRoleAssignment[] @relation("RoleAssignmentsGranted")

  createdVisits         Visit[]              @relation("VisitCreatedBy")
  decidedVisits         Visit[]              @relation("VisitDecidedBy")
  attendancesCheckedIn  Attendance[]         @relation("AttendanceCheckedInBy")
  attendancesCheckedOut Attendance[]         @relation("AttendanceCheckedOutBy")
  statusChangesMade     VisitStatusHistory[]
  notifications         Notification[]       @relation("NotificationRecipientUser")
  settingsUpdated       SystemSetting[]

  @@map("users")
}

/// Permission role assigned to dashboard users.
model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique // stable machine key, e.g. "ADMIN", "RECEPTION"
  name        String // human-readable label shown in the UI
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userAssignments UserRoleAssignment[]

  @@map("roles")
}

/// Assigns one or more roles to a user.
model UserRoleAssignment {
  id     Int  @id @default(autoincrement())
  userId Int  @map("user_id")
  user   User @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById Int?     @map("assigned_by_id") // User who granted this role, for audit purposes
  assignedBy   User?    @relation("RoleAssignmentsGranted", fields: [assignedById], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

/// Employee synchronized from the HR directory.
model Employee {
  id                 Int      @id @default(autoincrement())
  externalEmployeeId String   @unique @map("external_employee_id") // ID in the external HR/directory system
  firstName          String
  lastName           String
  email              String
  phone              String?
  departmentName     String
  departmentCode     String? // HR department code
  position           String?
  isActive           Boolean  @default(true)
  lastSyncedAt       DateTime @default(now()) @map("last_synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user         User?
  visitsAsHost Visit[]

  @@index([departmentName])
  @@index([isActive])
  @@map("employees")
}

/// External person visiting the organization.
model Visitor {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  email        String? // optional — some visitors have no email
  organization String?

  idType   IdentificationType
  idNumber String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visitLinks VisitParticipant[]

  @@unique([idType, idNumber])
  @@index([phone])
  @@index([lastName, firstName]) // supports reception's "search by name" lookup
  @@map("visitors")
}

/// Central record representing a visit request or invitation.
model Visit {
  id        Int    @id @default(autoincrement())
  visitCode String @unique // Human-readable visit code
  qrToken   String @unique // QR token

  origin       VisitOrigin
  groupType    VisitorGroupType
  durationType VisitDurationType
  status       VisitStatus

  purpose String @db.Text

  hostEmployeeId Int?      @map("host_employee_id")
  hostEmployee   Employee? @relation(fields: [hostEmployeeId], references: [id])

  // Preserves host details for historical reporting.
  hostEmailSnapshot      String?
  departmentNameSnapshot String?
  departmentCodeSnapshot String?

  isAssisted Boolean @default(false) // Created by staff on behalf of the visitor.

  createdById Int?  @map("created_by_id")
  createdBy   User? @relation("VisitCreatedBy", fields: [createdById], references: [id])

  decidedById  Int?      @map("decided_by_id")
  decidedBy    User?     @relation("VisitDecidedBy", fields: [decidedById], references: [id])
  decisionAt   DateTime? @map("decision_at")
  decisionNote String?   @db.Text

  visitExpiresAt DateTime? @map("visit_expires_at") // Expiration time for the approved visit.
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  schedules     VisitSchedule[]
  participants  VisitParticipant[]
  notifications Notification[]
  statusHistory VisitStatusHistory[]

  @@index([status])
  @@index([hostEmployeeId])
  @@map("visits")
}

/// Scheduled day for a visit.
model VisitSchedule {
  id                Int       @id @default(autoincrement())
  visitId           Int       @map("visit_id")
  visit             Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  date              DateTime  @db.Date
  expectedStartTime DateTime? @map("expected_start_time")
  expectedEndTime   DateTime? @map("expected_end_time")
  createdAt         DateTime  @default(now()) @map("created_at")

  attendances Attendance[]

  @@unique([visitId, date])
  @@map("visit_schedules")
}

/// Links a visitor to a visit.
model VisitParticipant {
  id        Int      @id @default(autoincrement())
  visitId   Int      @map("visit_id")
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitorId Int      @map("visitor_id")
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  attendances Attendance[]

  @@unique([visitId, visitorId])
  @@map("visit_participants")
}

/// Reusable physical visitor badge.
model Badge {
  id          Int         @id @default(autoincrement())
  badgeNumber Int         @unique
  qrToken     String      @unique
  status      BadgeStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  attendances Attendance[]

  @@index([status])
  @@map("badges")
}

/// Attendance record for one visitor on one scheduled day.
model Attendance {
  id Int @id @default(autoincrement())

  visitParticipantId Int              @map("visit_participant_id")
  visitParticipant   VisitParticipant @relation(fields: [visitParticipantId], references: [id])
  visitScheduleId    Int              @map("visit_schedule_id")
  visitSchedule      VisitSchedule    @relation(fields: [visitScheduleId], references: [id])

  badgeId         Int?      @map("badge_id")
  badge           Badge?    @relation(fields: [badgeId], references: [id])
  badgeAssignedAt DateTime? @map("badge_assigned_at") // Time the badge was assigned.

  status AttendanceStatus @default(SCHEDULED)

  checkInPhotoUrl      String? // taken with reception webcam at check-in
  personalIdRetained   Boolean   @default(false) // Indicates whether the visitor's ID is retained.
  personalIdReturnedAt DateTime? @map("personal_id_returned_at") // Time the retained ID was returned.

  checkInAt  DateTime? @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")

  checkedInById  Int?  @map("checked_in_by_id")
  checkedInBy    User? @relation("AttendanceCheckedInBy", fields: [checkedInById], references: [id])
  checkedOutById Int?  @map("checked_out_by_id")
  checkedOutBy   User? @relation("AttendanceCheckedOutBy", fields: [checkedOutById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([visitParticipantId, visitScheduleId])
  @@index([status])
  @@map("attendances")
}

/// Audit log of visit status changes.
model VisitStatusHistory {
  id          Int          @id @default(autoincrement())
  visitId     Int          @map("visit_id")
  visit       Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fromStatus  VisitStatus?
  toStatus    VisitStatus
  changedById Int?         @map("changed_by_id")
  changedBy   User?        @relation(fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([visitId])
  @@map("visit_status_history")
}

/// Email and dashboard notifications.
model Notification {
  id      Int                 @id @default(autoincrement())
  type    NotificationType
  channel NotificationChannel

  visitId Int?   @map("visit_id")
  visit   Visit? @relation(fields: [visitId], references: [id])

  recipientUserId Int?    @map("recipient_user_id")
  recipientUser   User?   @relation("NotificationRecipientUser", fields: [recipientUserId], references: [id])
  recipientEmail  String? /// Supports both internal users and external email recipients.

  subject   String?
  message   String    @db.Text
  isRead    Boolean   @default(false)
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([visitId])
  @@index([recipientUserId])
  @@map("notifications")
}

/// Configurable application settings.
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  updatedById Int?     @map("updated_by_id")
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

/// Authenticated user session.
model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}
