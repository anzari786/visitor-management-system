# VMS backend (must include /api/v1)
VMS_API_URL=http://localhost:5000/api/v1

# Shared secret with api PRINT_AGENT_TOKEN
PRINT_AGENT_TOKEN=change-me-print-agent-token

# Unique id for this agent instance (claim locking)
PRINT_AGENT_ID=reception-desk-1

# Zebra printer (network raw ZPL on port 9100 is typical)
ZEBRA_PRINTER_HOST=192.168.1.50
ZEBRA_PRINTER_PORT=9100
PRINTER_NAME=Zebra ZD420

# Polling
LONG_POLL_TIMEOUT_MS=30000
POLL_ERROR_DELAY_MS=3000

# Local diagnostics
HEALTH_PORT=5055

# Label geometry (inches / dots — 203 DPI defaults for 3x2 visitor badge)
LABEL_WIDTH_IN=3
LABEL_HEIGHT_IN=2
LABEL_DPI=203

# Transient printer retries inside the agent before reporting FAILED
PRINTER_RETRY_COUNT=2
PRINTER_RETRY_DELAY_MS=1500
