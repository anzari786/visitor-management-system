{
   "compilerOptions": {
      "rootDir": "./src",
      "outDir": "./dist",
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "lib": ["esnext"],
      "types": ["node"],
      "strict": true,
      "esModuleInterop": true,
      "isolatedModules": true,
      "skipLibCheck": true,
      "sourceMap": true
   },
   "include": ["src"]
}
