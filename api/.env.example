# DATABASE
DATABASE_URL="mysql://username:password@localhost:3306/vms_db"
DATABASE_USER="username"
DATABASE_PASSWORD="password"
DATABASE_NAME="vms_db"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# SESSION DATABASE
SESSION_DB_HOST=localhost
SESSION_DB_PORT=3306
SESSION_DB_USER=username
SESSION_DB_PASSWORD=password
SESSION_DB_NAME=vms_db

# SESSION
SESSION_SECRET="generate-a-random-secret"

# APP
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# SMTP (transactional email via Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ATI VMS <noreply@ati.gov.et>"

# Local Print Agent (shared bearer token — never expose to the browser)
PRINT_AGENT_TOKEN=change-me-print-agent-token
# Re-queue PRINTING jobs stuck longer than this (ms)
PRINT_JOB_STALE_MS=120000
PRINT_JOB_CHECK_INTERVAL_MS=750
